                    "sha256": "069cd2137e8028051389e3bbc1be884f00fcab182f43604e745457fba9784481"
                },
                {
                    "description": "PD-2026-007 (no CVE): validate the classification store column of the object grid sort before it becomes an SQL alias",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/admin-ui-classic-bundle-PD-2026-007-classificationstore-sort.patch",
                    "sha256": "4963bb1c0701250a750d9b97c7e158fbc3777c4300113deb9598c70318c0bf44"
