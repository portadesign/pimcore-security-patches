                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/pimcore-CVE-2026-55072-class-definition-id-regex.patch",
                    "sha256": "9448e68fd061894c51c26675226f57f7b7349ab589b3edc18437d97341e738d6"
                },
                {
                    "description": "CVE-2026-45260: WebDAV MOVE missing authorization",
