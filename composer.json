{
    "name": "portadesign/pimcore-security-patches",
    "description": "Security hardening of pimcore/pimcore 10.6.x against published CVEs, applied automatically on composer require, install and update",
    "type": "composer-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Portadesign",
            "email": "development@portadesign.cz",
            "homepage": "https://portadesign.cz"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.0",
        "cweagans/composer-patches": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "conflict": {
        "phpoffice/phpspreadsheet": "<1.30.7",
        "pimcore/pimcore": "<10.6.9 || >=10.7",
        "twig/twig": "<3.27.0"
    },
    "autoload": {
        "psr-4": {
            "Portadesign\\PimcoreSecurityPatches\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Portadesign\\PimcoreSecurityPatches\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G",
        "build-vex": "php bin/build-vex.php",
        "test-unit": "phpunit -c phpunit.unit.xml.dist"
    },
