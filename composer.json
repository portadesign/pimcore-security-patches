                {
                    "description": "CVE-2026-45162: unserialize without allowed_classes in the dashboard config reader",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/admin-ui-classic-bundle-CVE-2026-45162-dashboard.patch",
                    "sha256": "2230398e1bfb13acf53a2dc49da1cc95305d4cc6b483b9a0acdf6d5631b67057"
                },
                {
                    "description": "PD-2026-002 (no CVE): send mails built from finished or stored content without template rendering",
