                    "sha256": "3e9b63ac51fa7ea5b92da118172d18f92c2272d119c2b5ae9a571b0b800d51b1"
                },
                {
                    "description": "CVE-2026-45703: WordExport authorization bypass, view permission on exported elements",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/pimcore-CVE-2026-45703-wordexport-view-permission.patch",
                    "sha256": "8de108e979aab1b4ebb586478e7a894dda90cf73491171db3925d9706b7a1b57"
                },
                {
                    "description": "CVE-2026-45162: unserialize without allowed_classes in the WebDAV delete log, Table, Block, editables and other model readers; HMAC-signed session elements",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/pimcore-CVE-2026-45162-unserialize-remaining.patch",
                    "sha256": "b88693bcfab2883f906cdc161b18e62add11d40969b1ccb975e5f8085d5cee9d"
                },
                {
                    "description": "CVE-2026-45704: CustomReports sharing rules enforced on the detail, data and export endpoints",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/pimcore-CVE-2026-45704-custom-reports-share.patch",
                    "sha256": "7e41c7906cd037cbea53d89693f5b1587c61846fd11cd0b8402705cc1157461e"
                },
                {
                    "description": "PD-2026-002 (no CVE): send the application log summary mail without template rendering, log the sent subject",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/pimcore-PD-2026-002-mail-rendering.patch",
                    "sha256": "36d9b062599f800df742074fa1880341c2232b8831f83a09c943b8a6196eb1c0"
                }
            ],
            "pimcore/admin-ui-classic-bundle": [
                {
                    "description": "CVE-2026-44741: SQL injection in translation grid filters",
                    "url": "https://raw.githubusercontent.com/portadesign/pimcore-11-security-patches/v1.0.3/patches/admin-ui-classic-bundle-CVE-2026-44741-translation-grid.patch",
                    "sha256": "1f14117bd7a600582e38232872881302f09df15698251426505c02925e05e43f"
