ID: PD-2026-002 (no public advisory, Portadesign hardening)
Package: pimcore/pimcore
Verified: 11.5.4, 11.5.14.1
Summary: The application log summary mail is sent without template rendering, and the mail log stores the subject that was sent instead of rendering it again. The log summary mail is sent HTML-only; send() used to derive the text part from the HTML.

diff --git a/bundles/ApplicationLoggerBundle/src/Maintenance/LogMailMaintenanceTask.php b/bundles/ApplicationLoggerBundle/src/Maintenance/LogMailMaintenanceTask.php
index 6d3afe2..9da2307 100644
--- a/bundles/ApplicationLoggerBundle/src/Maintenance/LogMailMaintenanceTask.php
+++ b/bundles/ApplicationLoggerBundle/src/Maintenance/LogMailMaintenanceTask.php
@@ -101,7 +101,7 @@ class LogMailMaintenanceTask implements TaskInterface
                         $mail->addTo(new Address($receiver, $receiver));
                     }
                     $mail->subject('Error Log '.\Pimcore\Tool::getHostUrl());
-                    $mail->send();
+                    $mail->sendWithoutRendering();
                 }
             }
         }
