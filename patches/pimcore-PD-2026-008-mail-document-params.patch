+    private function convertHtmlToText(?string $htmlContent): string
+    {
+        if (!$htmlContent) {
+            return '';
+        }
+
+        try {
+            $html = new DomCrawler($htmlContent);
+
+            $body = $html->filter('body')->eq(0);
+            if ($body->count()) {
+                $style = $body->filter('style')->eq(0);
+                if ($style->count()) {
+                    $style->clear();
+                }
+                $htmlContent = $body->html();
+            }
+
+            $html->clear();
+            unset($html);
+
+            return $this->html2Text($htmlContent);
+        } catch (Exception $e) {
+            Logger::err((string) $e);
+
+            return '';
+        }
+    }
+
+    private const TEMPLATE_SYNTAX_PATTERN = '/\{\{.*?\}\}|\{%.*?%\}|\{#.*?#\}/s';
+
+    private function neutralizeForeignTemplateSyntax(string $html, Model\Document\Email $document): string
+    {
+        $allowed = [];
+        $collect = static function (mixed $value) use (&$collect, &$allowed): void {
+            if (is_array($value)) {
+                foreach ($value as $item) {
+                    $collect($item);
+                }
+
+                return;
+            }
+
+            if (!is_string($value)) {
+                return;
+            }
+
+            foreach ([$value, html_entity_decode($value, ENT_QUOTES | ENT_HTML5)] as $text) {
+                if (preg_match_all(self::TEMPLATE_SYNTAX_PATTERN, $text, $matches) > 0) {
+                    foreach ($matches[0] as $snippet) {
+                        $allowed[$snippet] = true;
+                    }
+                }
+            }
+        };
+
+        foreach ($document->getEditables() as $editable) {
+            $collect($editable->getData());
+        }
+
+        $snippets = array_keys($allowed);
+        usort($snippets, static fn (string $a, string $b): int => strlen($b) <=> strlen($a));
+        $pattern = '/' . implode('|', array_map(static fn (string $snippet): string => preg_quote($snippet, '/'), $snippets)) . ($snippets === [] ? '' : '|') . '\{(?=[{%#])/';
+
+        return (string) preg_replace_callback(
+            $pattern,
+            static fn (array $match): string => $match[0] === '{' ? '&#123;' : $match[0],
+            $html
+        );
+    }
+
